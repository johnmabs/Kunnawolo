generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String              @id
  name      String              @db.Text
  currency  String              @db.VarChar(3)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  audits    OrganizationAudit[]
  shops     Shop[]
  memberships OrganizationMembership[]
  categories Category[]
  products   Product[]
  productPrices ProductPrice[]
  stockLevels   StockLevel[]
  stockMovements StockMovement[]
  saleCarts      SaleCart[]
  salePayments   SalePayment[]
  salesSequence  SalesSequence?
}

model Category {
  id             String       @id
  organizationId String
  name           String       @db.Text
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
}

model ProductPrice {
  id                 String       @id
  organizationId     String
  productId          String
  referenceCostMinor BigInt
  salePriceMinor     BigInt
  currency           String       @db.VarChar(3)
  reference          String       @db.Text
  actorId            String?
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, productId, createdAt])
}

model Product {
  id             String       @id
  organizationId String
  name           String       @db.Text
  code           String?      @db.Text
  barcode        String?      @db.Text
  packaging      String?      @db.Text
  form           String?      @db.Text
  isActive       Boolean      @default(true)
  trackInventory Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  prices         ProductPrice[]
  stockLevels    StockLevel[]
  saleLines      SaleLine[]
  stockMovements StockMovement[]

  @@unique([organizationId, code])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
}

model UserAccount {
  id        String                   @id
  email     String                   @unique @db.Text
  displayName String                  @db.Text
  createdAt DateTime                 @default(now())
  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String       @id
  organizationId String
  userAccountId  String
  status         String       @db.VarChar(16)
  role           String       @db.VarChar(16) @default("CASHIER")
  invitedAt      DateTime     @default(now())
  activatedAt    DateTime?
  deactivatedAt  DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Restrict)
  shopAssignments ShopAssignment[]

  @@unique([organizationId, userAccountId])
}

model ShopAssignment {
  id           String                 @id
  membershipId String
  shopId       String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  shop         Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([membershipId, shopId])
}

model Shop {
  id             String       @id
  organizationId String
  code           String       @db.Text
  name           String       @db.Text
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    ShopAssignment[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  saleCarts      SaleCart[]

  @@unique([organizationId, code])
}

model StockLevel {
  id             String       @id
  organizationId String
  shopId         String
  productId      String
  quantity       Decimal      @db.Decimal(18, 3)
  lowStockThreshold Decimal  @default(0) @db.Decimal(18, 3)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([organizationId, shopId, productId])
}

model StockMovement {
  id             String       @id
  organizationId String
  shopId         String
  productId      String
  quantityDelta  Decimal      @db.Decimal(18, 3)
  reason         String       @db.Text
  actorId        String?
  idempotencyKey String?      @db.Text
  occurredAt     DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, shopId, productId, occurredAt])
  @@unique([organizationId, idempotencyKey])
}

model SaleCart {
  id             String     @id
  organizationId String
  shopId         String
  status         String     @db.VarChar(16) @default("DRAFT")
  finalizationReference String? @db.Text
  finalizedByActorId String?
  finalizedAt    DateTime?
  businessReference String? @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop           Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  lines          SaleLine[]
  payment        SalePayment?
  @@index([organizationId, shopId, status])
  @@unique([organizationId, finalizationReference])
  @@unique([organizationId, businessReference])
}

model SalePayment {
  id               String   @id
  organizationId   String
  saleCartId       String   @unique
  paymentReference String   @db.Text
  method           String   @db.VarChar(32)
  status           String   @db.VarChar(16)
  amountMinor      BigInt
  currency         String   @db.VarChar(3)
  actorId          String?
  paidAt           DateTime
  createdAt        DateTime @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  saleCart         SaleCart @relation(fields: [saleCartId], references: [id], onDelete: Restrict)

  @@unique([organizationId, paymentReference])
}

model SalesSequence {
  organizationId String @id
  nextValue      Int    @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model SaleLine {
  id                   String   @id
  saleCartId           String
  productId            String
  productNameSnapshot  String   @db.Text
  quantity             Decimal  @db.Decimal(18, 3)
  unitPriceMinor       BigInt
  unitCostMinor        BigInt
  currency             String   @db.VarChar(3)
  discountMinor        BigInt   @default(0)
  saleCart             SaleCart @relation(fields: [saleCartId], references: [id], onDelete: Restrict)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([saleCartId])
}

model OrganizationAudit {
  id             String       @id
  organizationId String
  actorId        String?
  action         String       @db.Text
  occurredAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
}
