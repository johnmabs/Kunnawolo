generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String              @id
  name      String              @db.Text
  currency  String              @db.VarChar(3)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  audits    OrganizationAudit[]
  shops     Shop[]
  memberships OrganizationMembership[]
  categories Category[]
  products   Product[]
  productPrices ProductPrice[]
  stockLevels   StockLevel[]
  stockMovements StockMovement[]
  saleCarts      SaleCart[]
  salePayments   SalePayment[]
  saleCancellations SaleCancellation[]
  salesSequence  SalesSequence?
  stockTransfers StockTransfer[]
  stockLosses    StockLoss[]
  inventorySessions InventorySession[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryReconciliations InventoryReconciliation[]
  expenseCategories ExpenseCategory[]
  expenses Expense[]
  expenseCancellations ExpenseCancellation[]
}

model Category {
  id             String       @id
  organizationId String
  name           String       @db.Text
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
}

model ExpenseCategory {
  id             String       @id
  organizationId String
  name           String       @db.Text
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenses       Expense[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Expense {
  id                String          @id
  organizationId    String
  expenseCategoryId String
  shopId            String?
  amountMinor       BigInt
  currency          String          @db.VarChar(3)
  reference         String          @db.Text
  description       String          @db.Text
  actorId           String?
  occurredAt        DateTime
  createdAt         DateTime        @default(now())
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)
  shop              Shop?           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  cancellation      ExpenseCancellation?

  @@unique([organizationId, reference])
  @@index([organizationId, shopId, occurredAt])
  @@index([organizationId, expenseCategoryId, occurredAt])
}

model ExpenseCancellation {
  id                    String   @id
  organizationId        String
  expenseId             String   @unique
  cancellationReference String   @db.Text
  reason                String   @db.Text
  actorId               String?
  cancelledAt           DateTime
  createdAt             DateTime @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expense               Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, cancellationReference])
  @@index([organizationId, cancelledAt])
}

model ProductPrice {
  id                 String       @id
  organizationId     String
  productId          String
  referenceCostMinor BigInt
  salePriceMinor     BigInt
  currency           String       @db.VarChar(3)
  reference          String       @db.Text
  actorId            String?
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, productId, createdAt])
}

model Product {
  id             String       @id
  organizationId String
  name           String       @db.Text
  code           String?      @db.Text
  barcode        String?      @db.Text
  packaging      String?      @db.Text
  form           String?      @db.Text
  isActive       Boolean      @default(true)
  trackInventory Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  prices         ProductPrice[]
  stockLevels    StockLevel[]
  saleLines      SaleLine[]
  stockMovements StockMovement[]
  transferLines  StockTransferLine[]
  stockLosses    StockLoss[]
  inventoryLines InventorySessionLine[]
  inventoryAdjustmentLines InventoryAdjustmentLine[]
  inventoryReconciliationLines InventoryReconciliationLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
}

model UserAccount {
  id        String                   @id
  email     String                   @unique @db.Text
  displayName String                  @db.Text
  createdAt DateTime                 @default(now())
  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String       @id
  organizationId String
  userAccountId  String
  status         String       @db.VarChar(16)
  role           String       @db.VarChar(16) @default("CASHIER")
  invitedAt      DateTime     @default(now())
  activatedAt    DateTime?
  deactivatedAt  DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Restrict)
  shopAssignments ShopAssignment[]

  @@unique([organizationId, userAccountId])
}

model ShopAssignment {
  id           String                 @id
  membershipId String
  shopId       String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  shop         Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([membershipId, shopId])
}

model Shop {
  id             String       @id
  organizationId String
  code           String       @db.Text
  name           String       @db.Text
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    ShopAssignment[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  saleCarts      SaleCart[]
  stockLosses    StockLoss[]
  inventorySessions InventorySession[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryReconciliations InventoryReconciliation[]
  expenses         Expense[]
  transfersFrom  StockTransfer[] @relation("TransferSourceShop")
  transfersTo    StockTransfer[] @relation("TransferDestinationShop")

  @@unique([organizationId, code])
}

model InventorySession {
  id             String   @id
  organizationId String
  shopId         String
  status         String   @db.VarChar(16) @default("OPEN")
  openedByActorId String?
  openedAt       DateTime
  closedByActorId String?
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  lines          InventorySessionLine[]
  adjustment     InventoryAdjustment?
  @@index([organizationId, shopId, status])
}

model InventorySessionLine {
  id                 String @id
  inventorySessionId String
  productId          String
  expectedQuantity   Decimal @db.Decimal(18, 3)
  countedQuantity    Decimal? @db.Decimal(18, 3)
  inventorySession   InventorySession @relation(fields: [inventorySessionId], references: [id], onDelete: Restrict)
  product            Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([inventorySessionId, productId])
}

model InventoryAdjustment {
  id                 String   @id
  organizationId     String
  inventorySessionId String   @unique
  shopId             String
  reference          String   @db.Text
  actorId            String?
  adjustedAt         DateTime
  createdAt          DateTime @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventorySession   InventorySession @relation(fields: [inventorySessionId], references: [id], onDelete: Restrict)
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  lines              InventoryAdjustmentLine[]

  @@unique([organizationId, reference])
  @@index([organizationId, shopId, adjustedAt])
}

model InventoryAdjustmentLine {
  id                    String   @id
  inventoryAdjustmentId String
  productId             String
  expectedQuantity      Decimal  @db.Decimal(18, 3)
  countedQuantity       Decimal  @db.Decimal(18, 3)
  quantityDelta         Decimal  @db.Decimal(18, 3)
  stockMovementId       String   @unique
  inventoryAdjustment   InventoryAdjustment @relation(fields: [inventoryAdjustmentId], references: [id], onDelete: Restrict)
  product               Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovement         StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@unique([inventoryAdjustmentId, productId])
}

model InventoryReconciliation {
  id             String   @id
  organizationId String
  shopId         String
  reference      String   @db.Text
  actorId        String?
  reconciledAt   DateTime
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  lines          InventoryReconciliationLine[]

  @@unique([organizationId, reference])
  @@index([organizationId, shopId, reconciledAt])
}

model InventoryReconciliationLine {
  id                      String   @id
  inventoryReconciliationId String
  productId               String
  stockLevelId            String
  stockLevelQuantity      Decimal  @db.Decimal(18, 3)
  ledgerQuantity          Decimal  @db.Decimal(18, 3)
  quantityDifference      Decimal  @db.Decimal(18, 3)
  inventoryReconciliation InventoryReconciliation @relation(fields: [inventoryReconciliationId], references: [id], onDelete: Restrict)
  product                 Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockLevel              StockLevel @relation(fields: [stockLevelId], references: [id], onDelete: Restrict)

  @@unique([inventoryReconciliationId, productId])
}

model StockLoss {
  id             String   @id
  organizationId String
  shopId         String
  productId      String
  quantity       Decimal  @db.Decimal(18, 3)
  reason         String   @db.Text
  referenceCostMinor BigInt
  currency       String   @db.VarChar(3)
  actorId        String?
  occurredAt     DateTime
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, shopId, occurredAt])
}

model StockLevel {
  id             String       @id
  organizationId String
  shopId         String
  productId      String
  quantity       Decimal      @db.Decimal(18, 3)
  lowStockThreshold Decimal  @default(0) @db.Decimal(18, 3)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryReconciliationLines InventoryReconciliationLine[]

  @@unique([organizationId, shopId, productId])
}

model StockMovement {
  id             String       @id
  organizationId String
  shopId         String
  productId      String
  quantityDelta  Decimal      @db.Decimal(18, 3)
  reason         String       @db.Text
  actorId        String?
  idempotencyKey String?      @db.Text
  occurredAt     DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryAdjustmentLine InventoryAdjustmentLine?

  @@index([organizationId, shopId, productId, occurredAt])
  @@unique([organizationId, idempotencyKey])
}

model StockTransfer {
  id                String   @id
  organizationId    String
  sourceShopId      String
  destinationShopId String
  status            String   @db.VarChar(16) @default("DRAFT")
  createdByActorId  String?
  shipmentReference String?  @db.Text
  sentByActorId     String?
  sentAt            DateTime?
  receptionReference String? @db.Text
  receivedByActorId String?
  receivedAt        DateTime?
  cancellationReference String? @db.Text
  cancellationReason String? @db.Text
  cancelledByActorId String?
  cancelledAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceShop        Shop     @relation("TransferSourceShop", fields: [sourceShopId], references: [id], onDelete: Restrict)
  destinationShop   Shop     @relation("TransferDestinationShop", fields: [destinationShopId], references: [id], onDelete: Restrict)
  lines             StockTransferLine[]

  @@index([organizationId, sourceShopId, status])
  @@index([organizationId, destinationShopId, status])
  @@unique([organizationId, shipmentReference])
  @@unique([organizationId, receptionReference])
  @@unique([organizationId, cancellationReference])
}

model StockTransferLine {
  id              String   @id
  stockTransferId String
  productId       String
  quantity        Decimal  @db.Decimal(18, 3)
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Restrict)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockTransferId, productId])
  @@index([productId])
}

model SaleCart {
  id             String     @id
  organizationId String
  shopId         String
  status         String     @db.VarChar(16) @default("DRAFT")
  finalizationReference String? @db.Text
  finalizedByActorId String?
  finalizedAt    DateTime?
  businessReference String? @db.Text
  underCostReason String? @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shop           Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  lines          SaleLine[]
  payment        SalePayment?
  cancellation   SaleCancellation?
  @@index([organizationId, shopId, status])
  @@unique([organizationId, finalizationReference])
  @@unique([organizationId, businessReference])
}

model SaleCancellation {
  id                    String   @id
  organizationId        String
  saleCartId            String   @unique
  cancellationReference String   @db.Text
  reason                String   @db.Text
  actorId               String?
  cancelledAt           DateTime
  createdAt             DateTime @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  saleCart              SaleCart @relation(fields: [saleCartId], references: [id], onDelete: Restrict)

  @@unique([organizationId, cancellationReference])
}

model SalePayment {
  id               String   @id
  organizationId   String
  saleCartId       String   @unique
  paymentReference String   @db.Text
  method           String   @db.VarChar(32)
  status           String   @db.VarChar(16)
  amountMinor      BigInt
  currency         String   @db.VarChar(3)
  actorId          String?
  paidAt           DateTime
  createdAt        DateTime @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  saleCart         SaleCart @relation(fields: [saleCartId], references: [id], onDelete: Restrict)

  @@unique([organizationId, paymentReference])
}

model SalesSequence {
  organizationId String @id
  nextValue      Int    @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model SaleLine {
  id                   String   @id
  saleCartId           String
  productId            String
  productNameSnapshot  String   @db.Text
  quantity             Decimal  @db.Decimal(18, 3)
  unitPriceMinor       BigInt
  unitCostMinor        BigInt
  currency             String   @db.VarChar(3)
  discountMinor        BigInt   @default(0)
  saleCart             SaleCart @relation(fields: [saleCartId], references: [id], onDelete: Restrict)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([saleCartId])
}

model OrganizationAudit {
  id             String       @id
  organizationId String
  actorId        String?
  action         String       @db.Text
  occurredAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
}
