{
  "name": "kunnawolo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": "24.x",
    "pnpm": "10.18.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && depcruise --config dependency-cruiser.config.cjs src",
    "check:architecture": "depcruise --config dependency-cruiser.config.cjs src",
    "prisma:generate": "prisma generate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "ops:verify-release": "sh scripts/verify-release.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/**/*.integration.test.ts",
    "test:integration": "vitest run src/infrastructure/prisma/prisma-client.integration.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.0.0",
    "next": "^16.0.0",
    "pg": "^8.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
